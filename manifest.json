{
  "manifest_version": 3,
  "name": "AppBird Game Exporter",
  "version": "1.0.0",
  "description": "Exports visible AppBird game names, publishers, and detail links to CSV.",
  "permissions": [
    "activeTab",
    "downloads",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://appbird.ai/*",
    "https://itunes.apple.com/*",
    "https://play.google.com/*",
    "https://sheets.googleapis.com/*"
  ],
  "action": {
    "default_title": "Export AppBird games",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://appbird.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": "",
  "oauth2": {
    "client_id": "716581046625-mffmk68979ba2r3ljf7079ocall2jgco.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  }
}
